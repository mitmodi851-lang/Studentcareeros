# Student Career OS — Environment Variables
# Copy this file to .env.local and fill in your values

# ─── Firebase Admin SDK ───────────────────────────────────────────
# From your Firebase project → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ─── NextAuth.js ──────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# ─── Firebase Emulator (optional, for local development) ──────────
# Uncomment these when running against the emulator
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
